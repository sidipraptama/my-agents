# Copy to .env and fill in before running `docker compose up`.

# Exactly 32 characters — used as the AES-256 key to encrypt model API keys at rest.
# Generate one with: openssl rand -base64 24 | cut -c1-32
ENCRYPTION_KEY=change-this-to-a-random-32-char-key

# Origin allowed to call the backend API (the frontend's URL).
ALLOWED_ORIGIN=http://localhost:3000

# URL the frontend uses to reach the backend, baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080
